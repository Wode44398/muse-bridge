# 复制成 .env 再填（cp .env.example .env）。改完 docker compose up -d 生效。完整说明见 docs/deploy-docker.md。
# 全都可以先留空：Claude 认证也能装好后在「设置 › Claude › 订阅号池」里加；其余都是可选功能，留空就是不开。

# ── 0. 这台服务器给谁用 ─────────────────────────────────────────────────────
# 留空 = 只给我自己（默认）：只有管理员（访问令牌 / 扫码配对的设备）能登录，注册与邀请码关着
# shared = 也给别人用：打开注册与邀请码，给家人朋友各开账号（各自的数据互相看不到；共用你配的 Claude 认证与额度）
# 只管默认值，以后在控制台「开放给其他人使用」里随时改，那边的开关为准。留空时已有的老数据卷照旧按它生成时的规矩，
# 填了 self / shared 就按你填的（控制台里没动过开关的话）。
BRIDGE_AUDIENCE=

# ── 1. Claude 认证（二选一；也可以留空，登录后在设置里加）──────────────────────
# A. Claude 订阅（Pro / Max）：在任意一台装了 Claude Code 的电脑上运行 `claude setup-token`，把输出的长期令牌填这里
#    使用者需自行遵守所用服务的条款。
CLAUDE_CODE_OAUTH_TOKEN=
# B. Anthropic API key（按量计费，console.anthropic.com）。dimensio 的 Anthropic 厂商也用它。
#    填了它 Claude 一律走按量计费：之后在「设置 › Claude › 订阅号池」里加的订阅令牌不会生效（Claude Code 的认证顺序）。
ANTHROPIC_API_KEY=

# ── 2. 对外访问（可选）───────────────────────────────────────────────────────
# Cloudflare Tunnel 的 token（docker compose --profile tunnel up -d 时用）。见 docs/deploy-docker.md。
# 也可以不填这里：登录后在控制台「服务控制 → 公网访问」里直接开（临时地址或命名隧道，服务端在容器里自己托管 cloudflared），
# 那时命名隧道的 Public Hostname 服务填 http://localhost:8787。同一条隧道别两边同时开。
TUNNEL_TOKEN=
# 你的公网访问地址，例如 https://bridge.example.com。分享链接、扫码配对的二维码会用它拼完整网址。
# 只在家里 Wi-Fi 直连、没有公网地址时别填这里：配合下面的 BRIDGE_BIND=0.0.0.0，出码时告诉它宿主机的局域网地址——
#   docker compose exec bridge node src/cli.mjs pair --origin=http://<这台机器的局域网 IP>:8787
BRIDGE_PUBLIC_ORIGIN=
# 宿主机上监听的地址与端口。默认只开在本机 127.0.0.1（前面放隧道或反向代理）；
# 想让同一个 Wi-Fi 里的手机直连就改成 0.0.0.0——那样务必确认防火墙，服务本身只靠令牌鉴权、走的是明文 http。
BRIDGE_BIND=127.0.0.1
BRIDGE_PUBLISH_PORT=8787

# ── 3. dimensio 分页的模型厂商（可选，填哪家就能用哪家；也可以进 dimensio 的设置里填）──
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
KIMI_API_KEY=
ZHIPU_API_KEY=
QWEN_API_KEY=
MIMO_API_KEY=

# ── 4. Gemini / Vertex 分页与媒体生成（可选）─────────────────────────────────
# 需要一个开了 Vertex AI 的 GCP 项目，以及服务账号 JSON（放进容器能读到的位置，见 docs/deploy-docker.md）。
VERTEX_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# ── 构建选项（改了要 docker compose up -d --build）────────────────────────────
# 1 = 镜像里装 LibreOffice，Word/Excel/PPT 能在线预览（镜像约大 600MB）
WITH_OFFICE=0
# 1 = 把 Claude Code 运行组件留在镜像里（约 250MB）。默认 0：服务端第一次启动时从官方 npm 源下载到数据卷，只下一次
WITH_CLAUDE_CLI=0
