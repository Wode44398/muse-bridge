{
  "name": "claude-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted bridge to drive Claude Code (and other agents) on your own machine from phone, desktop or browser.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "token": "node src/gen-token.mjs",
    "show-token": "node src/cli.mjs show-token",
    "invite": "node src/cli.mjs invite",
    "users": "node src/cli.mjs users",
    "users:export": "node src/users-migrate.mjs export",
    "users:import": "node src/users-migrate.mjs import",
    "set-auth": "node src/set-auth.mjs",
    "plugin:new": "node scripts/plugin-new.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.299",
    "@google/genai": "^2.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/headless": "^6.0.0",
    "google-auth-library": "^10.6.2",
    "node-pty": "^1.1.0",
    "sharp": "^0.35.0",
    "undici": "^7.28.0"
  }
}
