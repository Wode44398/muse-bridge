{
  "name": "muse-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One-click Claude Code (and the dimensio agent harness) for the Muse agent VM: a self-hosted web workbench you open from any browser.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "token": "node src/gen-token.mjs",
    "show-token": "node src/cli.mjs show-token",
    "invite": "node src/cli.mjs invite",
    "users": "node src/cli.mjs users",
    "users:export": "node src/users-migrate.mjs export",
    "users:import": "node src/users-migrate.mjs import",
    "set-auth": "node src/set-auth.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "sharp": "^0.35.0",
    "undici": "^7.28.0",
    "zod": "^4.4.3"
  },
  "license": "MIT"
}
