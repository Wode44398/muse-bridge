# Copy this file to ".env" and fill in ONE provider's credentials.
# The in-app Settings panel can override any of these at runtime.

# ── Anthropic (recommended: strongest coding) ────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI-compatible (OpenAI / DeepSeek / any compatible endpoint) ──────────
# OpenAI:   OPENAI_BASE_URL=https://api.openai.com/v1   OPENAI_MODEL=gpt-4o
# DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com    OPENAI_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── Xiaomi MiMo ──────────────────────────────────────────────────────────────
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.6-pro
# Also: mimo-v2.6-flash, mimo-v2.6-pro-ultraspeed (requires separate API access;
# the Token Plan CN endpoint currently rejects UltraSpeed).
# tp- keys automatically use https://token-plan-cn.xiaomimimo.com/v1;
# sk- keys use https://api.xiaomimimo.com/v1. Set an explicit URL for other regions.
# MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8799
# Directory the agent is allowed to read/write/run in (its sandbox).
# Defaults to ./workspace if left blank.
WORKSPACE_DIR=

# Directories outside the workspace that the agent may READ (never write, never
# run things from). Semicolon-separated absolute paths, reachable only by a plain
# read command (ls/cat/grep/find/…) — a redirect into one is still refused.
# Typical use: let it see which JDK/SDK this machine has instead of guessing.
# DIMENSIO_READONLY_PATHS=/usr/lib/jvm;/opt/android-sdk
