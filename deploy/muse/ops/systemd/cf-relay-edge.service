[Unit]
Description=socat relay 127.0.0.1:7844 -> egress proxy -> @EDGE@:7844 (cloudflared tunnel data)
After=network.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:7844,bind=127.0.0.1,fork,reuseaddr PROXY:@PROXY_HOST@:@EDGE@:7844,proxyport=@PROXY_PORT@
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
